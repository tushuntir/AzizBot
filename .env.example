BOT_TOKEN=123456:your-token-from-BotFather
# Telegram user IDs of bot admins (comma-separated). Get yours from @userinfobot.
# Admins get /admin: user count, broadcast to all users, required channels.
ADMIN_IDS=123456789
# Default language for new users if their Telegram language isn't supported: en | uz | ru
DEFAULT_LANG=en
# Max simultaneous downloads
MAX_JOBS=3
# Private channel (ID like -100xxxxxxxxxx or @channel) the bot is admin in.
# Every downloaded video/audio is forwarded there and its file_id is cached,
# so repeat requests are served instantly without re-downloading.
# CACHE_CHANNEL=-1001234567890
# bgutil PO-token provider base URL. Docker compose sets this automatically to http://bgutil:4416.
POT_BASE_URL=http://127.0.0.1:4416
# Optional: cookies file (Netscape format) if YouTube/Instagram blocks downloads.
# With docker compose, the ./cookies.txt mount already covers this:
COOKIES_FILE=/app/cookies.txt
# Set to "none" to disable cookies entirely and test POT-only behavior:
# COOKIES_FILE=none
# On hosts WITHOUT volume mounts (Railway/Render/Fly/...), cookies.txt never
# arrives because .dockerignore excludes it from the image. Instead paste
# base64(cookies.txt) here — downloader.py materializes it at startup:
#   Linux:  base64 -w0 cookies.txt
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
# COOKIES_B64=PASTE_BASE64_HERE
# Comma-separated YouTube player clients, tried in order.
# No cookies: tv,web_safari | With cookies: web_safari,web_embedded,mweb
# YT_PLAYER_CLIENT=tv,web_safari
